FROM python:3.10-slim

# Install system dependencies and build tools
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsm6 \
    libxext6 \
    libgl1 \
    libglx-mesa0 \
    libglib2.0-0 \
    wget \
    build-essential \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
COPY requirements-cpu.lock .
RUN pip3 install --no-cache-dir -r requirements-cpu.lock

# Create working directory
WORKDIR /app

# Create necessary directories
RUN mkdir -p /temp/models /temp/media /temp/cache

# Download the official model release and verify it before adding it to the image.
RUN wget -q https://github.com/deepinsight/insightface/releases/download/v0.7/inswapper_128.onnx \
        -O /temp/models/inswapper_128.onnx \
    && echo "e4a3f08c753cb72d04e10aa0f7dbe3deebbf39567d4ead6dce08e98aa49e16af  /temp/models/inswapper_128.onnx" | sha256sum -c -

# Build arguments for version info
ARG GIT_COMMIT=unknown

# Copy application files after the stable dependency and model layers.
COPY . .

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    DEVICE_TYPE=cpu \
    MAX_CONCURRENT_JOBS=1 \
    GIT_COMMIT=${GIT_COMMIT}

# Run application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7860", "--workers", "1", "--no-proxy-headers"]
