# Telegram Bot API client
TELEGRAM_APITOKEN=123456789:replace_me
BOT_DEBUG=false

# Local Telegram Bot API server (https://my.telegram.org/apps)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_me
TELEGRAM_STAT=1
# linux/amd64 digest; override explicitly when deploying another architecture.
TELEGRAM_BOT_API_IMAGE=aiogram/telegram-bot-api@sha256:af7603382a56586f90c2a597faf56bc082287025be516eff4230330cd1b0457b

# PocketBase administrator used by the internal services
POCKETBASE_LOGIN=admin@example.com
POCKETBASE_PASSWORD=replace_me

# Internal face-swap authentication; generate a long random value.
FACE_SWAP_API_KEY=replace_with_a_long_random_value

# Optional host-side ports (all bind to 127.0.0.1)
TELEGRAM_API_PORT=8081
TELEGRAM_STAT_PORT=8082
POCKETBASE_PORT=8080
FACE_SWAP_PORT=7860

# Optional processing limits
MAX_VIDEO_BYTES=524288000
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_SECONDS=300
MAX_FRAME_PIXELS=2073600
MAX_IMAGE_PIXELS=25000000
